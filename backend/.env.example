# Do not commit secrets, provider credentials, customer data, or production values.
APP_NAME=agentlens-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# Neon pooled runtime URL. postgresql:// is normalized to postgresql+psycopg://.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require
# Optional direct Neon URL for Alembic. Falls back to DATABASE_URL when omitted.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_SCENARIO=normal_day
DEFAULT_SEED=2026
LOG_LEVEL=INFO
MAX_PAGE_SIZE=100
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=20
